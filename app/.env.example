# 恒野 GEO 自研版 · 环境变量
# 复制为 app/.env 后填写；一个都不填也能跑 demo 流程
#
# 引擎与 OmniRank 对齐（5 个中文引擎）：
#   通义千问(DASHSCOPE) · DeepSeek · 豆包(火山方舟) · Kimi · 元宝(中转)

# ── DeepSeek 官方（https://platform.deepseek.com）
# 诊断默认走联网检索（Responses API + web_search，模型 deepseek-v4-pro），
# 一次问答约 1-2 分钱；30 题一轮约 3-6 毛。
DEEPSEEK_API_KEY=

# ── 阿里云百炼 DashScope（https://bailian.console.aliyun.com）
# 通义千问 qwen-plus，走 extra_body.enable_search 联网
DASHSCOPE_API_KEY=

# ── 豆包 / 火山方舟（https://console.volcengine.com/ark）
# DOUBAO_MODEL 必须填控制台的推理接入点 ID（ep-2024xxxx）或模型 ID（doubao-seed-1-6-250615）
DOUBAO_API_KEY=
# ARK_API_KEY=            # 与 DOUBAO_API_KEY 等价，填一个即可
DOUBAO_MODEL=
# DOUBAO_SEARCH=0         # 设为 0 可关掉联网工具（只做对照，不用于正式诊断）

# ── Kimi / 月之暗面（https://platform.moonshot.cn）
KIMI_API_KEY=
# MOONSHOT_API_KEY=       # 等价别名
# KIMI_MODEL=kimi-k2-0905-preview
# KIMI_SEARCH=0           # 设为 0 可关掉 $web_search 内置搜索

# ── 元宝：没有官方对话 API，走 OpenAI 兼容中转
# YUANBAO_BASE_URL 填中转根地址（如 https://xxx/v1），程序自动拼 /chat/completions
YUANBAO_BASE_URL=
YUANBAO_API_KEY=
# YUANBAO_MODEL=yuanbao

# 可选：数据目录覆盖（默认 app/data）
# HENGYE_GEO_DATA_DIR=
