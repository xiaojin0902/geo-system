# 恒野 GEO · 环境变量（复制为 app/.env 后填写）
#
# 一个都不填也能跑：mock 引擎 + dry_run 发布 + 模板写稿。
# 想接真实能力，按下面分组填。

# ═══════════════════════════════════════════════════════════════
# 一、AI 引擎（13 家；填哪家，诊断就能用哪家）
#    采样时会按「已配置」自动挑选；没配的引擎不会出现在结果里
# ═══════════════════════════════════════════════════════════════

# ── DeepSeek（默认主力；联网检索走 Responses API）
# https://platform.deepseek.com  ·  一次 12 题约 ¥0.3
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro

# ── 阿里通义千问（百炼；enable_search 联网）
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus

# ── 豆包 / 火山方舟（DOUBAO_MODEL 必填：推理接入点 ID 或模型 ID）
DOUBAO_API_KEY=
# ARK_API_KEY=            # 与 DOUBAO_API_KEY 等价
DOUBAO_MODEL=
# DOUBAO_SEARCH=0         # 0 = 关联网工具（仅对照用）

# ── Kimi / 月之暗面（内置 $web_search）
KIMI_API_KEY=
# MOONSHOT_API_KEY=       # 等价别名
# KIMI_MODEL=kimi-k2-0905-preview
# KIMI_SEARCH=0

# ── 腾讯元宝（无官方对话 API，需 OpenAI 兼容中转根地址）
YUANBAO_BASE_URL=
YUANBAO_API_KEY=
# YUANBAO_MODEL=yuanbao

# ── 文心一言 / 百度千帆 v2（支持 web_search 工具）
QIANFAN_API_KEY=
# QIANFAN_MODEL=ernie-4.5-turbo-128k

# ── 智谱 GLM（支持 web_search 工具）
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-plus

# ── 腾讯混元（OpenAI 兼容）
HUNYUAN_API_KEY=
# HUNYUAN_MODEL=hunyuan-turbos-latest

# ── MiniMax（OpenAI 兼容）
MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-Text-01

# ── Google Gemini（OpenAI 兼容端点；搜索接地需原生 API）
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── Perplexity（自带联网检索与 citations）
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro

# ── Claude / Anthropic（Messages API，内置 web_search 工具）
CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=      # 等价别名
# CLAUDE_MODEL=claude-sonnet-4-5

# ── OpenAI ChatGPT（本适配器为对话模式，非联网搜索）
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════
# 二、发布渠道
# ═══════════════════════════════════════════════════════════════

# 默认 dry_run；设 0 且没配任何渠道 = 全部 not_connected
# PUBLISH_DRY_RUN=1

# 通用 Webhook（任意自建分发服务）
# PUBLISH_WEBHOOK_WEBHOOK=https://your-service/publish

# 各平台 webhook（配了就升级为 api 态；格式 PUBLISH_<渠道ID大写>_WEBHOOK）
# PUBLISH_ZHIHU_WEBHOOK=
# PUBLISH_XIAOHONGSHU_WEBHOOK=
# PUBLISH_TOUTIAO_WEBHOOK=
# PUBLISH_BAIJIAHAO_WEBHOOK=
# PUBLISH_NETEASE_WEBHOOK=
# PUBLISH_SINA_WEBHOOK=
# PUBLISH_DOUYIN_WEBHOOK=
# PUBLISH_BILIBILI_WEBHOOK=

# ── 微信公众号官方 API（唯一完整官方发布能力；需认证号 + IP 白名单）
WECHAT_APPID=
WECHAT_SECRET=
# WECHAT_AUTO_PUBLISH=1   # 1 = 建完草稿自动群发（默认只建草稿）
# WECHAT_SOURCE_URL=https://sanrenxing.cn

# ── 浏览器半自动（知乎/头条/百家号/小红书/抖音/公众号后台）
# Chrome 需带调试端口启动：open -na "Google Chrome" --args --remote-debugging-port=9222
# BROWSER_DEBUG_PORT=9222

# ═══════════════════════════════════════════════════════════════
# 三、服务运行（部署 / 对外交付时用）
# ═══════════════════════════════════════════════════════════════

# 控制台默认品牌（多品牌时用 --brand 覆盖）
# GEO_BRAND=hengye

# 对外服务必须开 Basic Auth（不给密码 = 无鉴权，只适合本机）
# BASIC_USER=hengye
# BASIC_PASS=

# 控制台端口（PaaS 会用 PORT 环境变量覆盖）
# PORT=8787

# 数据目录（默认 app/data；容器部署可挂卷）
# HENGYE_GEO_DATA_DIR=
