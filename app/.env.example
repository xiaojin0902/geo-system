# GEO 代运营交付系统 v2 · 环境变量
# 复制为 app/.env

# 管理员初始密码（首次启动创建 admin 时使用；之后改这里不会重置）
ADMIN_PASSWORD=

# 真实引擎（不配就用 mock 演示引擎）
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 任意 OpenAI 兼容端点（通义/豆包/Kimi 等）
# CUSTOM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=qwen-plus

# 服务端口（默认 8787）
# PORT=8787

# 对外地址（生成分享链接用）
# GEO_PUBLIC_URL=https://geo.example.com
